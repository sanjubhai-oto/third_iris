<?xml version="1.0" ?>
<!-- Air-to-air engagement world (PX4 SITL). VEHICLE-FREE on purpose: two PX4 instances spawn their
     own jetray variants into this running server (chaser=jetray_chaser_0, runner=jetray_runner_1).
     Launched standalone via sim/gz/a2a/launch_a2a.sh (software GL; PX4 attaches with PX4_GZ_STANDALONE=1).
     Plugin set + scene copied from the proven uav_track_up.sdf (renders under WSL llvmpipe). -->
<sdf version="1.9">
  <world name="uav_a2a">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- headless `gz sim -s` needs these explicitly. PX4-FLOWN vehicles require the IMU/AirPressure/
         Magnetometer/NavSat sensor SYSTEMS (else EKF gets no data and arming is denied) — full set
         mirrors PX4's server.config. Sensors = camera render; UserCommands = set_pose + /create spawn. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.55 0.70 0.92 1</background>   <!-- clear blue sky: best contrast for the dark drone -->
      <sky/>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>1000 1000</size></plane></geometry>
          <material><diffuse>0.30 0.40 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- GROUND TARGET (UGV): UAVros SUV mesh (real car) -> detected as an OBJECT (YOLO/COCO "car")
         from the chaser's down camera, not by colour. Pose-driven kinematically by rover_mover.py. -->
    <include>
      <uri>model://suv</uri>
      <name>rover</name>
      <pose>10 -6 0 0 0 0</pose>
    </include>
  </world>
</sdf>
