<?xml version="1.0" ?>
<!-- Clean dataset-capture world: a STATIC camera (no drift, no self-arm) + a kinematic x500 target that
     we teleport around via set_pose. Background subtraction then isolates ONLY the target -> exact bbox.
     Launch: gz sim -s -r capture_cam.sdf  (software GL). -->
<sdf version="1.9">
  <world name="capworld">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.55 0.70 0.92 1</background><sky/></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 100 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse><specular>0.3 0.3 0.3 1</specular><direction>-0.3 0.2 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
        <material><diffuse>0.30 0.40 0.28 1</diffuse></material></visual></link></model>

    <!-- STATIC capture camera at 8 m, looking +X. Target gets teleported to high/mid/low positions in
         front of it so the BACKGROUND varies (sky / horizon / ground) without moving the camera. -->
    <model name="capcam"><static>true</static><pose>0 0 8 0 0 0</pose><link name="link">
      <sensor name="cam" type="camera"><pose>0 0 0 0 0 0</pose><topic>capcam/image</topic>
        <camera><horizontal_fov>1.74</horizontal_fov><image><width>1280</width><height>960</height></image>
          <clip><near>0.1</near><far>3000</far></clip></camera>
        <always_on>1</always_on><update_rate>20</update_rate></sensor></link></model>

    <!-- x500 target (kinematic, set_pose-driven). -->
    <include><uri>model://x500</uri><name>target</name><pose>15 0 8 0 0 0</pose></include>
  </world>
</sdf>
