<?xml version="1.0" ?>
<!-- Multi-target "team sky monitor" world: one chaser with an up-facing camera watches MULTIPLE enemy
     drones (red/green/blue) maneuvering overhead. Tests detect+track of all sky drones at once with
     persistent IDs (the "team to monitor live"). Poses driven via /world/uav_track_team/set_pose. -->
<sdf version="1.9">
  <world name="uav_track_team">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.7 0.8 0.95 1</background><sky/></scene>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 100 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse><specular>0.3 0.3 0.3 1</specular><direction>-0.3 0.2 -0.9</direction></light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>500 500</size></plane></geometry>
        <material><diffuse>0.3 0.4 0.3 1</diffuse></material></visual></link></model>

    <!-- SPECTATOR camera: 3rd-person view of the whole engagement, published on /spectator -->
    <model name="spectator"><static>true</static><pose>16 0 12 0 -0.30 3.14159</pose>
      <link name="l"><sensor name="spec" type="camera"><topic>spectator</topic>
        <camera><horizontal_fov>1.4</horizontal_fov><image><width>1280</width><height>720</height></image>
          <clip><near>0.1</near><far>600</far></clip></camera>
        <always_on>1</always_on><update_rate>15</update_rate></sensor></link></model>

    <include><uri>model://jetray</uri><name>chaser</name><pose>0 0 4 0 0 0</pose></include>
    <include><uri>model://jetray_target_red</uri><name>target_red</name><pose>3 2 18 0 0 0</pose></include>
    <include><uri>model://jetray_target_green</uri><name>target_green</name><pose>-4 3 20 0 0 0</pose></include>
    <include><uri>model://jetray_target_blue</uri><name>target_blue</name><pose>2 -5 19 0 0 0</pose></include>
  </world>
</sdf>
